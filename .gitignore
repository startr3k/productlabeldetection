.*

# Keep the CI workflow tracked despite the dotfile rule above.
!/.gitignore
!/.github
!/.github/**

# Python build and test artifacts
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.coverage

# Secrets: service account keys, environment files, credentials
key.json
*-key.json
service-account*.json
.env
.env.*
!.env.example
