# Copy to .env and fill in, or export these in your shell.
# Cloud Run and Cloud Functions are configured the same way, via their own
# environment-variable settings.

# Google Cloud project that owns the Document AI processors and Datastore.
PROJECT_ID=your-project-id

# Document AI location. 'us' or 'eu'.
LOCATION=us

# Bucket holding the product label images (must be .gif).
BUCKET_LABEL=your-label-image-bucket

# Bucket holding the 'Made in Australia' crops written by the Cloud Function.
BUCKET_EXTRACT=your-extracted-image-bucket

# Datastore kinds.
DATASTORE_EXTRACT=Extractions
DATASTORE_USER=Users

# Optional: path to a service account key for local development. If unset, the
# client libraries fall back to Application Default Credentials. Never commit
# the key file; it is gitignored.
# GOOGLE_APPLICATION_CREDENTIALS=./key.json
